{
  "name": "bright-security-engine",
  "version": "0.1.0",
  "description": "Copilot coding agent engine for Bright DAST security scanning and auto-remediation",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:bin": "npm run build && bun build --compile --minify dist/index.js --outfile bright-agent"
  },
  "dependencies": {
    "@sectester/core": "^0.50.0",
    "@sectester/repeater": "^0.50.0",
    "glob": "^11.0.0",
    "openai": "^4.86.0",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}